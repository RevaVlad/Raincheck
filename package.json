{
  "name": "raincheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:frontend": "npm --prefix frontend run start",
    "dev:backend": "npm --prefix backend run dev",
    "format": "prettier --write \"backend/**/*.{ts,sql,json}\" \"frontend/**/*.{ts,html,css,json}\" \"*.{json,mjs}\" \".github/workflows/*.yml\" \"prober/**/*.{ts,json}\"",
    "format:check": "prettier --check \"backend/**/*.{ts,sql,json}\" \"frontend/**/*.{ts,html,css,json}\" \"*.{json,mjs}\" \".github/workflows/*.yml\" \"prober/**/*.{ts,json}\"",
    "lint": "eslint \"backend/{src,tests}/**/*.ts\" \"frontend/src/**/*.ts\" \"prober/{src,tests}/**/*.ts\"",
    "build": "npm --prefix backend run build && npm --prefix frontend run build && npm --prefix prober run build",
    "test": "npm --prefix backend run test && npm --prefix frontend run test && npm --prefix prober run test",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck && npm --prefix prober run typecheck",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "npm --prefix backend run prisma:deploy",
    "db:migrate:status": "npm --prefix backend run prisma:status",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:validate": "npm --prefix backend run prisma:validate",
    "prisma:deploy": "npm --prefix backend run prisma:deploy",
    "prisma:status": "npm --prefix backend run prisma:status",
    "dev:prober": "npm --prefix prober run dev"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "prettier-plugin-sql": "^0.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
